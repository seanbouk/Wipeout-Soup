+// ---------------------------------------------------------------------------
+// Motion vectors (presentation only). A game mod names where its camera lives
+// in guest RAM — a rotation (3x3 int16, the same matrix the GTE uses for
+// static world geometry) and an offset (int32[3], -camera position, added to
+// world points before rotation). The clock is the render, not game logic:
+// gpu.c calls psx_mv_render_boundary() when the game flips its display buffer,
+// and the camera latched at each render's first projection becomes "previous"
+// for the next (Wipeout's game logic runs at 30 fps but trackside cameras
+// render at 60). Every projection then also gets the screen position its point
+// had in the previous render, assuming the point is static in the world:
+//     W + off  = Rᵀ·view           (view = MAC, R = camera rotation / 4096)
+//     view'    = R'·(Rᵀ·view − off + off')
+// projected with this projection's own H/OFX/OFY and widescreen X factor.
+// Projections whose RT isn't the camera rotation (moving objects) get no
+// motion yet. Nothing here changes what the game computes.
+// ---------------------------------------------------------------------------
+struct MvCamera { int16_t r[9]; int32_t off[3]; };
+static int      s_mv_on = 0;
+static uint32_t s_mv_rot_addr = 0, s_mv_off_addr = 0;
+static MvCamera s_mv_prev;                /* camera of the previous render  */
+static int      s_mv_have_prev = 0;
+static MvCamera s_mv_latch;               /* camera of the current render   */
+static int      s_mv_latched = 0;
+static struct { uint64_t frames, proj, static_proj, produced, behind; } s_mv_stats;
+/* Timing diagnostic: per game frame, the offset at frame end and the offsets
+ * live at its first and last static projection (debug server mv_stats). */
+struct MvFrameRec { int32_t end_off[3], first_off[3], last_off[3]; uint32_t nproj; };
+static MvFrameRec s_mv_hist[8];
+static MvFrameRec s_mv_cur_rec;
+
+static void mv_read_camera(MvCamera* c) {
+    for (int i = 0; i < 9; i++) c->r[i] = (int16_t)psx_mod_read_half(s_mv_rot_addr + i * 2);
+    for (int i = 0; i < 3; i++) c->off[i] = (int32_t)psx_mod_read_word(s_mv_off_addr + i * 4);
+}
+extern "C" void psx_mv_enable(int on) { s_mv_on = on ? 1 : 0; s_mv_have_prev = 0; s_mv_latched = 0; }
+extern "C" void psx_mv_set_camera(uint32_t rot_addr, uint32_t off_addr) {
+    if (rot_addr != s_mv_rot_addr || off_addr != s_mv_off_addr) s_mv_have_prev = s_mv_latched = 0;
+    s_mv_rot_addr = rot_addr;
+    s_mv_off_addr = off_addr;
+}
+extern "C" void psx_mv_render_boundary(void) {
+    if (!s_mv_on || !s_mv_rot_addr || !s_mv_latched) return;   /* no 3D this render */
+    s_mv_prev = s_mv_latch;
+    s_mv_have_prev = 1;
+    s_mv_latched = 0;
+    MvCamera now;
+    mv_read_camera(&now);
+    for (int i = 0; i < 3; i++) s_mv_cur_rec.end_off[i] = now.off[i];
+    s_mv_hist[s_mv_stats.frames % 8] = s_mv_cur_rec;
+    memset(&s_mv_cur_rec, 0, sizeof s_mv_cur_rec);
+    s_mv_have_prev = 1;
+    s_mv_stats.frames++;
+}
+extern "C" unsigned long long psx_mv_frame_count(void) { return s_mv_stats.frames; }
+extern "C" int psx_mv_stats_json(char* out, int n) {
+    int k = 0;
+    k += snprintf(out + k, n - k, "\"hist\":[");
+    for (int j = 0; j < 8 && k < n; j++) {
+        const MvFrameRec* h = &s_mv_hist[(s_mv_stats.frames + j) % 8];
+        k += snprintf(out + k, n - k, "%s{\"n\":%u,\"first\":[%d,%d,%d],\"last\":[%d,%d,%d],\"end\":[%d,%d,%d]}",
+                      j ? "," : "", h->nproj, h->first_off[0], h->first_off[1], h->first_off[2],
+                      h->last_off[0], h->last_off[1], h->last_off[2],
+                      h->end_off[0], h->end_off[1], h->end_off[2]);
+    }
+    k += snprintf(out + k, n - k, "],");
+    return k + snprintf(out + k, n - k, "\"on\":%d,\"rot\":\"0x%08X\",\"off\":\"0x%08X\",\"have_prev\":%d,"
+                    "\"frames\":%llu,\"projections\":%llu,\"static\":%llu,\"produced\":%llu,\"behind\":%llu",
+                    s_mv_on, s_mv_rot_addr, s_mv_off_addr, s_mv_have_prev,
+                    (unsigned long long)s_mv_stats.frames, (unsigned long long)s_mv_stats.proj,
+                    (unsigned long long)s_mv_stats.static_proj, (unsigned long long)s_mv_stats.produced,
+                    (unsigned long long)s_mv_stats.behind);
+}
+static void mv_project_prev(const GTEState* gte, int64_t mac1, int64_t mac2, int64_t mac3,
+                            double xk, int64_t sx16, int64_t sy16) {
+    s_mv_stats.proj++;
+    MvCamera cur;
+    mv_read_camera(&cur);
+    for (int r = 0; r < 3; r++)
+        for (int c = 0; c < 3; c++)
+            if (gte->RT[r][c] != cur.r[r * 3 + c]) return;   /* not static world */
+    s_mv_stats.static_proj++;
+    if (!s_mv_latched) { s_mv_latch = cur; s_mv_latched = 1; }
+    if (!s_mv_have_prev) return;
+    if (s_mv_cur_rec.nproj++ == 0)
+        for (int i = 0; i < 3; i++) s_mv_cur_rec.first_off[i] = cur.off[i];
+    for (int i = 0; i < 3; i++) s_mv_cur_rec.last_off[i] = cur.off[i];
+    const double view[3] = { mac1 / 4096.0, mac2 / 4096.0, mac3 / 4096.0 };
+    double w[3], vp[3];
+    for (int i = 0; i < 3; i++) {
+        double a = 0;
+        for (int k = 0; k < 3; k++) a += cur.r[k * 3 + i] * view[k];
+        w[i] = a / 4096.0 - cur.off[i] + s_mv_prev.off[i];
+    }
+    for (int i = 0; i < 3; i++) {
+        double a = 0;
+        for (int k = 0; k < 3; k++) a += s_mv_prev.r[i * 3 + k] * w[k];
+        vp[i] = a / 4096.0;
+    }
+    if (vp[2] < 1.0) { s_mv_stats.behind++; return; }
+    const double lim = 4096.0 * 65536.0;
+    double px = gte->OFX + xk * gte->H * vp[0] / vp[2] * 65536.0;
+    double py = gte->OFY + gte->H * vp[1] / vp[2] * 65536.0;
+    if (px < -lim || px >= lim || py < -lim || py >= lim) return;
+    pgxp_gte_set_motion((int32_t)((double)sx16 - px), (int32_t)((double)sy16 - py));
+    s_mv_stats.produced++;
+}
