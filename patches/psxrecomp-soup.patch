+/* vk_presenter.c — Vulkan presenter for the OpenGL renderer. See vk_presenter.h.
+ *
+ * Frame protocol (binary semaphores, both exported to GL):
+ *   GL draws the frame into the shared image, then glSignalSemaphoreEXT(gl_done)
+ *   -> Vulkan waits gl_done + the swapchain acquire, blits shared -> swapchain
+ *      image (Y-flipped: GL rows are bottom-up), signals vk_done and the
+ *      per-image present semaphore, presents
+ *   -> GL glWaitSemaphoreEXT(vk_done) before it touches the shared image again.
+ * Every gl_done signal is matched by exactly one Vulkan wait, even when the
+ * acquire fails, so the binary semaphores never double-signal.
+ *
+ * Vulkan presents to a CHILD window laid over the game window's client area,
+ * not to the game window itself. On NVIDIA a window can't carry both the GL
+ * context and a Vulkan swapchain: with GL first, swapchain creation fails
+ * (VK_ERROR_NATIVE_WINDOW_IN_USE_KHR); with Vulkan first, wglMakeCurrent
+ * fails. The child is input-transparent (HTTRANSPARENT, disabled), so mouse
+ * and keyboard still reach the game window, and it is resized to match the
+ * client area on every present.
+ *
+ * Vulkan is loaded at runtime from vulkan-1.dll (no link dependency). The
+ * headers come from the game project (PSX_VK_PRESENTER builds only). */
+#include "vk_presenter.h"
+
+#if defined(PSX_VK_PRESENTER) && defined(_WIN32)
+
+#define VK_NO_PROTOTYPES
+#define VK_USE_PLATFORM_WIN32_KHR
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <vulkan/vulkan.h>
+#include <SDL3/SDL.h>
+#include <stdio.h>
+#include <string.h>
+
