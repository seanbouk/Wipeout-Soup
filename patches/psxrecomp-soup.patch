+static MvObjXf* mv_obj_find(int tab, uint32_t key, uint16_t ord, int create) {
+    uint32_t h = mv_obj_hash(key, ord);
+    for (uint32_t i = 0; i < MV_OBJ_CAP; i++) {
+        MvObjXf* e = &s_mv_obj_tab[tab][(h + i) & (MV_OBJ_CAP - 1)];
+        if (!e->used) {
+            if (!create) return nullptr;
+            e->used = 1; e->key = key; e->ordinal = ord;
+            return e;
+        }
