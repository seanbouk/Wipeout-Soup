+// ---------------------------------------------------------------------------
+// Motion vectors (presentation only). A game mod names where its camera lives
+// in guest RAM — a rotation (3x3 int16, the same matrix the GTE uses for
+// static world geometry) and an offset (int32[3], -camera position, added to
+// world points before rotation). The clock is the render, not game logic:
+// gpu.c calls psx_mv_render_boundary() when the game flips its display buffer,
+// and the camera latched at each render's first projection becomes "previous"
+// for the next (Wipeout's game logic runs at 30 fps but trackside cameras
+// render at 60). Every projection then also gets the screen position its point
+// had in the previous render, assuming the point is static in the world:
+//     W + off  = Rᵀ·view           (view = MAC, R = camera rotation / 4096)
+//     view'    = R'·(Rᵀ·view − off + off')
+// projected with this projection's own H/OFX/OFY and widescreen X factor.
+// Projections whose RT isn't the camera rotation (moving objects) get no
+// motion yet. Nothing here changes what the game computes.
+// ---------------------------------------------------------------------------
+struct MvCamera { int16_t r[9]; int32_t off[3]; };
+static int      s_mv_on = 0;
+static uint32_t s_mv_rot_addr = 0, s_mv_off_addr = 0;
+static MvCamera s_mv_prev;                /* camera of the previous render  */
+static int      s_mv_have_prev = 0;
