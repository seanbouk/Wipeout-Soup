+/* Window-sized RGBA8 image in exportable Vulkan memory, imported into GL as a
+ * texture behind an FBO (plus a GL-only depth-stencil renderbuffer). Sets
+ * V.status to the failing step. */
+static int create_shared(int w, int h) {
+#define SFAIL(why) do { snprintf(V.status, sizeof V.status, "off (shared image: %s)", why); return 0; } while (0)
+    VkExternalMemoryImageCreateInfo emi = { VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO, NULL,
+                                            VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT };
+    VkImageCreateInfo ii = { VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO, &emi, 0, VK_IMAGE_TYPE_2D, VK_FORMAT_R8G8B8A8_UNORM,
+                             { (uint32_t)w, (uint32_t)h, 1 }, 1, 1, VK_SAMPLE_COUNT_1_BIT, VK_IMAGE_TILING_OPTIMAL,
+                             /* Every usage GL might put a texture to: the driver picks the
+                              * memory layout from these, and GL assumes its own full set.
+                              * A narrower set gives GL a smaller allocation than it expects
+                              * (glTexStorageMem2DEXT -> GL_OUT_OF_MEMORY). */
+                             VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT |
+                             VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_STORAGE_BIT |
+                             VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT,
+                             VK_SHARING_MODE_EXCLUSIVE, 0, NULL, VK_IMAGE_LAYOUT_UNDEFINED };
+    if (vkCreateImage(V.dev, &ii, NULL, &V.sh_img) != VK_SUCCESS) SFAIL("vkCreateImage");
+    VkMemoryRequirements mr;
+    vkGetImageMemoryRequirements(V.dev, V.sh_img, &mr);
+    uint32_t mt = find_mem_type(mr.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+    if (mt == UINT32_MAX) SFAIL("no device-local memory type");
+    VkMemoryDedicatedAllocateInfo ded = { VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO, NULL, V.sh_img, VK_NULL_HANDLE };
+    VkExportMemoryAllocateInfo ex = { VK_STRUCTURE_TYPE_EXPORT_MEMORY_ALLOCATE_INFO, &ded,
+                                      VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT };
+    VkMemoryAllocateInfo ai = { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO, &ex, mr.size, mt };
+    if (vkAllocateMemory(V.dev, &ai, NULL, &V.sh_mem) != VK_SUCCESS) SFAIL("vkAllocateMemory");
+    if (vkBindImageMemory(V.dev, V.sh_img, V.sh_mem, 0) != VK_SUCCESS) SFAIL("vkBindImageMemory");
+    V.sh_size = mr.size;
+    VkMemoryGetWin32HandleInfoKHR hi = { VK_STRUCTURE_TYPE_MEMORY_GET_WIN32_HANDLE_INFO_KHR, NULL, V.sh_mem,
+                                         VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT };
+    HANDLE h_mem = NULL;
+    if (vkGetMemoryWin32HandleKHR(V.dev, &hi, &h_mem) != VK_SUCCESS) SFAIL("vkGetMemoryWin32HandleKHR");
+    while (gl.GetError() != 0) {}             /* report this step's errors, not stale ones */
+    gl.CreateMemoryObjectsEXT(1, &V.gl_mem);
+    /* The Vulkan side is a dedicated allocation; GL must be told before import. */
+    const GLint_ dedicated = 1;
+    GLenum_ e[4];
+    gl.MemoryObjectParameterivEXT(V.gl_mem, VKP_GL_DEDICATED_MEMORY_OBJECT, &dedicated);
+    e[0] = gl.GetError();
+    gl.ImportMemoryWin32HandleEXT(V.gl_mem, V.sh_size, VKP_GL_HANDLE_TYPE_OPAQUE_WIN32, h_mem);
+    e[1] = gl.GetError();
+    CloseHandle(h_mem);                        /* GL holds its own reference */
+    gl.GenTextures(1, &V.gl_tex);
+    gl.BindTexture(VKP_GL_TEXTURE_2D, V.gl_tex);
+    gl.TexStorageMem2DEXT(VKP_GL_TEXTURE_2D, 1, VKP_GL_RGBA8, w, h, V.gl_mem, 0);
+    e[2] = gl.GetError();
+    gl.BindTexture(VKP_GL_TEXTURE_2D, 0);
+    gl.GenRenderbuffers(1, &V.gl_rb);
+    gl.BindRenderbuffer(VKP_GL_RENDERBUFFER, V.gl_rb);
+    gl.RenderbufferStorage(VKP_GL_RENDERBUFFER, VKP_GL_DEPTH24_STENCIL8, w, h);
+    e[3] = gl.GetError();
+    gl.BindRenderbuffer(VKP_GL_RENDERBUFFER, 0);
+    gl.GenFramebuffers(1, &V.gl_fbo);
+    gl.BindFramebuffer(VKP_GL_FRAMEBUFFER, V.gl_fbo);
+    gl.FramebufferTexture2D(VKP_GL_FRAMEBUFFER, VKP_GL_COLOR_ATTACHMENT0, VKP_GL_TEXTURE_2D, V.gl_tex, 0);
+    gl.FramebufferRenderbuffer(VKP_GL_FRAMEBUFFER, VKP_GL_DEPTH_STENCIL_ATTACHMENT, VKP_GL_RENDERBUFFER, V.gl_rb);
+    GLenum_ st = gl.CheckFramebufferStatus(VKP_GL_FRAMEBUFFER);
+    gl.BindFramebuffer(VKP_GL_FRAMEBUFFER, 0);
+    V.w = w; V.h = h;
+    if (st != VKP_GL_FRAMEBUFFER_COMPLETE) {
+        snprintf(V.status, sizeof V.status, "off (shared image: GL framebuffer status 0x%X; GL errors dedicated 0x%X import 0x%X storage 0x%X depth 0x%X; size %llu for %dx%d)",
+                 (unsigned)st, (unsigned)e[0], (unsigned)e[1], (unsigned)e[2], (unsigned)e[3],
+                 (unsigned long long)V.sh_size, w, h);
+        return 0;
+    }
+    return 1;
+#undef SFAIL
+}
+
+/* Vulkan half of the semaphore pair: create both exportable semaphores and
+ * keep their Win32 handles until GL imports them. */
+static HANDLE s_sem_handles[2];
+static int create_semaphores_vk(void) {
+    VkExportSemaphoreCreateInfo ex = { VK_STRUCTURE_TYPE_EXPORT_SEMAPHORE_CREATE_INFO, NULL,
+                                       VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_WIN32_BIT };
+    VkSemaphoreCreateInfo xi = { VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO, &ex, 0 };
+    VkSemaphoreCreateInfo pi = { VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO, NULL, 0 };
+    if (vkCreateSemaphore(V.dev, &xi, NULL, &V.gl_done) != VK_SUCCESS ||
+        vkCreateSemaphore(V.dev, &xi, NULL, &V.vk_done) != VK_SUCCESS ||
+        vkCreateSemaphore(V.dev, &pi, NULL, &V.acquire) != VK_SUCCESS) return 0;
+    VkSemaphoreGetWin32HandleInfoKHR hi = { VK_STRUCTURE_TYPE_SEMAPHORE_GET_WIN32_HANDLE_INFO_KHR, NULL, V.gl_done,
+                                            VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_WIN32_BIT };
+    if (vkGetSemaphoreWin32HandleKHR(V.dev, &hi, &s_sem_handles[0]) != VK_SUCCESS) return 0;
+    hi.semaphore = V.vk_done;
+    if (vkGetSemaphoreWin32HandleKHR(V.dev, &hi, &s_sem_handles[1]) != VK_SUCCESS) return 0;
+    return 1;
+}
+static void import_semaphores_gl(void) {
+    gl.GenSemaphoresEXT(1, &V.gl_sem_gl_done);
+    gl.GenSemaphoresEXT(1, &V.gl_sem_vk_done);
+    gl.ImportSemaphoreWin32HandleEXT(V.gl_sem_gl_done, VKP_GL_HANDLE_TYPE_OPAQUE_WIN32, s_sem_handles[0]);
+    gl.ImportSemaphoreWin32HandleEXT(V.gl_sem_vk_done, VKP_GL_HANDLE_TYPE_OPAQUE_WIN32, s_sem_handles[1]);
+}
+static void close_semaphore_handles(void) {
+    for (int i = 0; i < 2; i++)
+        if (s_sem_handles[i]) { CloseHandle(s_sem_handles[i]); s_sem_handles[i] = NULL; }
+}
+
+static void update_status(void) {
+    VkPhysicalDeviceProperties p;
+    vkGetPhysicalDeviceProperties(V.pd, &p);
+    const char *m = V.mode == VK_PRESENT_MODE_FIFO_KHR ? "fifo" : V.mode == VK_PRESENT_MODE_FIFO_RELAXED_KHR ? "fifo-relaxed"
+                  : V.mode == VK_PRESENT_MODE_MAILBOX_KHR ? "mailbox" : V.mode == VK_PRESENT_MODE_IMMEDIATE_KHR ? "immediate" : "?";
+    snprintf(V.status, sizeof V.status, "vulkan %s, %s, %dx%d", p.deviceName, m, V.w, V.h);
+}
+
+static int s_prepared = 0;   /* Vulkan half done (vkp_prepare) */
+
+void vkp_shutdown(void) {
+    close_semaphore_handles();
+    s_prepared = 0;
+    if (!V.dev && !V.inst) return;
+    if (V.dev) {
+        vkDeviceWaitIdle(V.dev);
+        if (gl.DeleteFramebuffers) destroy_shared();
+        destroy_swapchain();
+        if (V.gl_sem_gl_done) gl.DeleteSemaphoresEXT(1, &V.gl_sem_gl_done);
+        if (V.gl_sem_vk_done) gl.DeleteSemaphoresEXT(1, &V.gl_sem_vk_done);
+        if (V.gl_done) vkDestroySemaphore(V.dev, V.gl_done, NULL);
+        if (V.vk_done) vkDestroySemaphore(V.dev, V.vk_done, NULL);
+        if (V.acquire) vkDestroySemaphore(V.dev, V.acquire, NULL);
+        if (V.fence) vkDestroyFence(V.dev, V.fence, NULL);
+        if (V.pool) vkDestroyCommandPool(V.dev, V.pool, NULL);
+        vkDestroyDevice(V.dev, NULL);
+    }
+    if (V.surf) vkDestroySurfaceKHR(V.inst, V.surf, NULL);
+    if (V.inst) vkDestroyInstance(V.inst, NULL);
+    if (V.lib) FreeLibrary(V.lib);
+    destroy_child();
+    memset(&V, 0, sizeof V);
+    memset(&gl, 0, sizeof gl);
+}
+
+/* Vulkan half: child window, instance, surface, device, swapchain,
+ * semaphores. No GL needed, so it can run before or after the GL context. */
+static int prepare_impl(struct SDL_Window *win) {
+#define FAIL(why) do { if (!V.status[0]) snprintf(V.status, sizeof V.status, "off (%s failed)", why); return 0; } while (0)
+    V.lib = LoadLibraryA("vulkan-1.dll");
+    if (!V.lib) { snprintf(V.status, sizeof V.status, "off (no vulkan-1.dll)"); return 0; }
+    V.gipa = (PFN_vkGetInstanceProcAddr)(void *)GetProcAddress(V.lib, "vkGetInstanceProcAddr");
+    if (!V.gipa) FAIL("vkGetInstanceProcAddr");
+    vkCreateInstance = (PFN_vkCreateInstance)(void *)V.gipa(NULL, "vkCreateInstance");
+    const char *iext[] = { "VK_KHR_surface", "VK_KHR_win32_surface" };
+    VkApplicationInfo app = { VK_STRUCTURE_TYPE_APPLICATION_INFO, NULL, "psxrecomp", 1, "psxrecomp", 1, VK_API_VERSION_1_2 };
+    VkInstanceCreateInfo ici = { VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO, NULL, 0, &app, 0, NULL, 2, iext };
+    if (!vkCreateInstance || vkCreateInstance(&ici, NULL, &V.inst) != VK_SUCCESS) FAIL("vkCreateInstance");
+    if (!load_vk_instance_fns()) FAIL("Vulkan instance functions");
+    HWND hwnd = (HWND)SDL_GetPointerProperty(SDL_GetWindowProperties(win), SDL_PROP_WINDOW_WIN32_HWND_POINTER, NULL);
+    if (!hwnd || !create_child(hwnd)) FAIL("creating the presenter child window");
+    VkWin32SurfaceCreateInfoKHR sci = { VK_STRUCTURE_TYPE_WIN32_SURFACE_CREATE_INFO_KHR, NULL, 0, GetModuleHandleW(NULL), s_child };
+    if (vkCreateWin32SurfaceKHR(V.inst, &sci, NULL, &V.surf) != VK_SUCCESS) FAIL("vkCreateWin32SurfaceKHR");
+    /* Device: prefer discrete; needs a graphics queue that can present here. */
+    VkPhysicalDevice pds[8]; uint32_t npd = 8;
+    if (vkEnumeratePhysicalDevices(V.inst, &npd, pds) != VK_SUCCESS || npd == 0) FAIL("vkEnumeratePhysicalDevices");
+    int best = -1;
+    for (uint32_t i = 0; i < npd; i++) {
+        VkQueueFamilyProperties qf[16]; uint32_t nq = 16;
+        vkGetPhysicalDeviceQueueFamilyProperties(pds[i], &nq, qf);
+        for (uint32_t q = 0; q < nq; q++) {
+            VkBool32 sup = VK_FALSE;
+            vkGetPhysicalDeviceSurfaceSupportKHR(pds[i], q, V.surf, &sup);
+            if (!(qf[q].queueFlags & VK_QUEUE_GRAPHICS_BIT) || !sup) continue;
+            VkPhysicalDeviceProperties p; vkGetPhysicalDeviceProperties(pds[i], &p);
+            int score = p.deviceType == VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU ? 2 : 1;
+            if (score > best) { best = score; V.pd = pds[i]; V.qfi = q; }
+            break;
+        }
+    }
+    if (best < 0) FAIL("finding a GPU that can present to the window");
+    float prio = 1.0f;
+    VkDeviceQueueCreateInfo qci = { VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO, NULL, 0, V.qfi, 1, &prio };
+    const char *dext[] = { "VK_KHR_swapchain", "VK_KHR_external_memory_win32", "VK_KHR_external_semaphore_win32" };
+    VkDeviceCreateInfo dci = { VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO, NULL, 0, 1, &qci, 0, NULL, 3, dext, NULL };
+    if (vkCreateDevice(V.pd, &dci, NULL, &V.dev) != VK_SUCCESS) FAIL("vkCreateDevice");
+    if (!load_vk_device_fns()) FAIL("Vulkan device functions");
+    vkGetDeviceQueue(V.dev, V.qfi, 0, &V.queue);
+    VkCommandPoolCreateInfo cpi = { VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO, NULL,
+                                    VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT, V.qfi };
+    if (vkCreateCommandPool(V.dev, &cpi, NULL, &V.pool) != VK_SUCCESS) FAIL("vkCreateCommandPool");
+    VkCommandBufferAllocateInfo cai = { VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO, NULL, V.pool,
+                                        VK_COMMAND_BUFFER_LEVEL_PRIMARY, 1 };
+    if (vkAllocateCommandBuffers(V.dev, &cai, &V.cb) != VK_SUCCESS) FAIL("vkAllocateCommandBuffers");
+    VkFenceCreateInfo fci = { VK_STRUCTURE_TYPE_FENCE_CREATE_INFO, NULL, 0 };
+    if (vkCreateFence(V.dev, &fci, NULL, &V.fence) != VK_SUCCESS) FAIL("vkCreateFence");
+    if (!create_semaphores_vk()) FAIL("exportable semaphores");
+    int r = create_swapchain();
+    if (r == 0) {
+        snprintf(V.status, sizeof V.status, "off (swapchain on the game window failed: VkResult %d)", (int)s_sc_err);
+        return 0;
+    }
+    if (r < 0) V.sc_stale = 1;                   /* window not shown yet: retry at present */
+    V.win = win;
+    return 1;
+#undef FAIL
+}
+
+int vkp_prepare(struct SDL_Window *win) {
+    if (s_prepared) return 1;
+    if (!prepare_impl(win)) {
+        char why[256];
+        snprintf(why, sizeof why, "%s", V.status[0] ? V.status : "off (Vulkan setup failed)");
+        vkp_shutdown();
+        snprintf(V.status, sizeof V.status, "%s", why);
+        return 0;
+    }
+    s_prepared = 1;
+    return 1;
+}
+
+/* GL half: entry points, semaphore import, shared image. */
+int vkp_init(struct SDL_Window *win) {
+    if (V.on) return 1;
+    if (!s_prepared && !vkp_prepare(win)) return 0;
+    int ok = 0;
+    if (!load_gl()) {
+        snprintf(V.status, sizeof V.status, "off (GL lacks memory_object/semaphore_win32)");
+    } else {
+        import_semaphores_gl();
+        close_semaphore_handles();
+        int pw = 0, ph = 0;
+        SDL_GetWindowSizeInPixels(win, &pw, &ph);
+        if (pw <= 0 || ph <= 0) snprintf(V.status, sizeof V.status, "off (window has no size)");
+        else ok = create_shared(pw, ph);
+    }
+    if (!ok) {
+        char why[256];
+        snprintf(why, sizeof why, "%s", V.status);
+        vkp_shutdown();
+        snprintf(V.status, sizeof V.status, "%s", why);
+        return 0;
+    }
+    V.on = 1;
+    update_status();
+    return 1;
+}
+
+unsigned vkp_fbo(void) { return V.on ? V.gl_fbo : 0u; }
+const char *vkp_status(void) { return V.status[0] ? V.status : "off"; }
+
+void vkp_set_vsync(int interval) {
+    s_want_interval = interval;
+    if (V.on && pick_mode(s_want_interval) != V.mode) V.sc_stale = 1;
+}
+
+static void barrier(VkImage img, VkImageLayout from, VkImageLayout to, uint32_t src_q, uint32_t dst_q,
+                    VkAccessFlags src_a, VkAccessFlags dst_a, VkPipelineStageFlags src_s, VkPipelineStageFlags dst_s) {
+    VkImageMemoryBarrier b = { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER, NULL, src_a, dst_a, from, to, src_q, dst_q, img,
+                               { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 } };
+    vkCmdPipelineBarrier(V.cb, src_s, dst_s, 0, 0, NULL, 0, NULL, 1, &b);
+}
+
+void vkp_present(void) {
+    if (!V.on) return;
+    /* GL: frame finished -> hand the shared image to Vulkan. */
+    GLenum_ to_src = VKP_GL_LAYOUT_TRANSFER_SRC;
+    gl.SignalSemaphoreEXT(V.gl_sem_gl_done, 0, NULL, 1, &V.gl_tex, &to_src);
+    gl.Flush();
+
+    if (V.fence_pending) {                       /* previous blit done: cb free */
+        vkWaitForFences(V.dev, 1, &V.fence, VK_TRUE, UINT64_MAX);
+        vkResetFences(V.dev, 1, &V.fence);
+        V.fence_pending = 0;
+    }
+    sync_child_size();
+    if (V.sc_stale || !V.sc) {
+        vkDeviceWaitIdle(V.dev);
+        if (create_swapchain() == 1) update_status();
+        else V.sc_stale = 1;
+    }
+    uint32_t idx = UINT32_MAX;
+    VkResult ar = VK_ERROR_OUT_OF_DATE_KHR;
+    if (V.sc && !V.sc_stale)
+        ar = vkAcquireNextImageKHR(V.dev, V.sc, 1000000000ull, V.acquire, VK_NULL_HANDLE, &idx);
+    const int have_img = (ar == VK_SUCCESS || ar == VK_SUBOPTIMAL_KHR);
+    if (ar == VK_SUBOPTIMAL_KHR || ar == VK_ERROR_OUT_OF_DATE_KHR) V.sc_stale = 1;
+
+    VkCommandBufferBeginInfo bi = { VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO, NULL,
+                                    VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT };
+    vkResetCommandBuffer(V.cb, 0);
+    vkBeginCommandBuffer(V.cb, &bi);
+    /* Acquire the shared image from GL (external queue family). */
+    barrier(V.sh_img, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+            VK_QUEUE_FAMILY_EXTERNAL, V.qfi, 0, VK_ACCESS_TRANSFER_READ_BIT,
+            VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT);
+    if (have_img) {
+        barrier(V.sc_img[idx], VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                VK_QUEUE_FAMILY_IGNORED, VK_QUEUE_FAMILY_IGNORED, 0, VK_ACCESS_TRANSFER_WRITE_BIT,
+                VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT);
+        /* GL rows are bottom-up: flip Y. Same size, so NEAREST is exact. */
+        VkImageBlit blit = { { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 }, { { 0, V.h, 0 }, { V.w, 0, 1 } },
+                             { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+                             { { 0, 0, 0 }, { (int32_t)V.sc_ext.width, (int32_t)V.sc_ext.height, 1 } } };
+        const int same = (uint32_t)V.w == V.sc_ext.width && (uint32_t)V.h == V.sc_ext.height;
+        vkCmdBlitImage(V.cb, V.sh_img, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, V.sc_img[idx],
+                       VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &blit, same ? VK_FILTER_NEAREST : VK_FILTER_LINEAR);
+        barrier(V.sc_img[idx], VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_PRESENT_SRC_KHR,
+                VK_QUEUE_FAMILY_IGNORED, VK_QUEUE_FAMILY_IGNORED, VK_ACCESS_TRANSFER_WRITE_BIT, 0,
+                VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT);
+    }
+    /* Release the shared image back to GL as a colour attachment. */
+    barrier(V.sh_img, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
+            V.qfi, VK_QUEUE_FAMILY_EXTERNAL, VK_ACCESS_TRANSFER_READ_BIT, 0,
+            VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT);
+    vkEndCommandBuffer(V.cb);
+
+    /* Always consume gl_done and signal vk_done, image or not, so the binary
+     * semaphore pair stays balanced. */
+    VkSemaphore waits[2] = { V.gl_done, V.acquire };
+    VkPipelineStageFlags ws[2] = { VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT };
+    VkSemaphore sigs[2] = { V.vk_done, have_img ? V.present_sem[idx] : VK_NULL_HANDLE };
+    VkSubmitInfo si = { VK_STRUCTURE_TYPE_SUBMIT_INFO, NULL, have_img ? 2u : 1u, waits, ws, 1, &V.cb,
+                        have_img ? 2u : 1u, sigs };
+    if (vkQueueSubmit(V.queue, 1, &si, V.fence) == VK_SUCCESS) V.fence_pending = 1;
+    if (have_img) {
+        VkPresentInfoKHR pi = { VK_STRUCTURE_TYPE_PRESENT_INFO_KHR, NULL, 1, &V.present_sem[idx], 1, &V.sc, &idx, NULL };
+        VkResult pr = vkQueuePresentKHR(V.queue, &pi);
+        if (pr == VK_SUBOPTIMAL_KHR || pr == VK_ERROR_OUT_OF_DATE_KHR) V.sc_stale = 1;
+    }
+
+    /* GL: wait (GPU-side) until Vulkan is done with the image. */
+    GLenum_ to_att = VKP_GL_LAYOUT_COLOR_ATTACHMENT;
+    gl.WaitSemaphoreEXT(V.gl_sem_vk_done, 0, NULL, 1, &V.gl_tex, &to_att);
+
+    /* Follow window resizes: the next frame draws into a matching image. */
+    int pw = 0, ph = 0;
+    SDL_GetWindowSizeInPixels(V.win, &pw, &ph);
+    if (pw > 0 && ph > 0 && (pw != V.w || ph != V.h)) {
+        gl.Finish();
+        if (V.fence_pending) {
+            vkWaitForFences(V.dev, 1, &V.fence, VK_TRUE, UINT64_MAX);
+            vkResetFences(V.dev, 1, &V.fence);
+            V.fence_pending = 0;
+        }
+        vkDeviceWaitIdle(V.dev);
+        destroy_shared();
+        if (!create_shared(pw, ph)) {
+            /* Can't continue on Vulkan: give the window back to GL. */
+            snprintf(V.status, sizeof V.status, "off (resize to %dx%d failed)", pw, ph);
+            V.on = 0;
+            return;
+        }
+        V.sc_stale = 1;
+        update_status();
+    }
+}
+
+#else  /* !PSX_VK_PRESENTER: inert */
+
+int vkp_prepare(struct SDL_Window *win) { (void)win; return 0; }
+int vkp_init(struct SDL_Window *win) { (void)win; return 0; }
+unsigned vkp_fbo(void) { return 0u; }
+void vkp_present(void) {}
+void vkp_set_vsync(int interval) { (void)interval; }
+void vkp_shutdown(void) {}
+const char *vkp_status(void) { return "off (not built: PSX_VK_PRESENTER)"; }
+
+#endif
