+static void destroy_shared(void) {
+    if (V.gl_fbo) { gl.DeleteFramebuffers(1, &V.gl_fbo); V.gl_fbo = 0; }
+    if (V.gl_rb) { gl.DeleteRenderbuffers(1, &V.gl_rb); V.gl_rb = 0; }
+    if (V.gl_tex) { gl.DeleteTextures(1, &V.gl_tex); V.gl_tex = 0; }
+    if (V.gl_mem) { gl.DeleteMemoryObjectsEXT(1, &V.gl_mem); V.gl_mem = 0; }
+    if (V.sh_img) { vkDestroyImage(V.dev, V.sh_img, NULL); V.sh_img = 0; }
+    if (V.sh_mem) { vkFreeMemory(V.dev, V.sh_mem, NULL); V.sh_mem = 0; }
+    V.w = V.h = 0;
+}
