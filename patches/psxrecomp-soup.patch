+static void mv_emit(const GTEState* gte, const double vc[3], const double vp[3], double xk) {
+    if (vp[2] < 1.0 || vc[2] < 1.0) { s_mv_stats.behind++; return; }
+    const double k = gte->H * 65536.0;
+    const double dx = xk * k * (vc[0] / vc[2] - vp[0] / vp[2]);
+    const double dy = k * (vc[1] / vc[2] - vp[1] / vp[2]);
+    const double lim = 4096.0 * 65536.0;
+    if (dx < -lim || dx >= lim || dy < -lim || dy >= lim) return;
+    pgxp_gte_set_motion((int32_t)dx, (int32_t)dy);
+    s_mv_stats.produced++;
