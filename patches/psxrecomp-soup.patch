+static uint32_t find_mem_type(uint32_t bits, VkMemoryPropertyFlags want) {
+    VkPhysicalDeviceMemoryProperties mp;
+    vkGetPhysicalDeviceMemoryProperties(V.pd, &mp);
+    for (uint32_t i = 0; i < mp.memoryTypeCount; i++)
+        if ((bits & (1u << i)) && (mp.memoryTypes[i].propertyFlags & want) == want) return i;
+    return UINT32_MAX;
+}
+
+static VkPresentModeKHR pick_mode(int interval) {
+    VkPresentModeKHR modes[8]; uint32_t n = 8;
+    if (vkGetPhysicalDeviceSurfacePresentModesKHR(V.pd, V.surf, &n, modes) != VK_SUCCESS) n = 0;
+    /* "No vsync" prefers MAILBOX: never waits for vblank, like immediate, but
+     * never tears either (the newest frame replaces a queued one). That's what
+     * a 60 fps game on a 75 Hz panel wants; GL could only choose tearing. */
+    VkPresentModeKHR want = interval > 0 ? VK_PRESENT_MODE_FIFO_KHR
+                          : interval < 0 ? VK_PRESENT_MODE_FIFO_RELAXED_KHR
+                                         : VK_PRESENT_MODE_MAILBOX_KHR;
+    for (uint32_t i = 0; i < n; i++) if (modes[i] == want) return want;
+    if (interval == 0)
+        for (uint32_t i = 0; i < n; i++) if (modes[i] == VK_PRESENT_MODE_IMMEDIATE_KHR) return modes[i];
+    return VK_PRESENT_MODE_FIFO_KHR;              /* always available */
+}
+
+static void destroy_swapchain(void) {
+    for (uint32_t i = 0; i < V.sc_n; i++)
+        if (V.present_sem[i]) { vkDestroySemaphore(V.dev, V.present_sem[i], NULL); V.present_sem[i] = 0; }
+    if (V.sc) { vkDestroySwapchainKHR(V.dev, V.sc, NULL); V.sc = 0; }
+    V.sc_n = 0;
+}
+
+/* 1 = created, 0 = failed (V.sc_err says why), -1 = window has no size yet
+ * (hidden or minimised): try again at the next present. */
+static VkResult s_sc_err = VK_SUCCESS;
+static int create_swapchain(void) {
+    VkSurfaceCapabilitiesKHR caps;
+    if ((s_sc_err = vkGetPhysicalDeviceSurfaceCapabilitiesKHR(V.pd, V.surf, &caps)) != VK_SUCCESS) return 0;
+    if (caps.currentExtent.width == 0 || caps.currentExtent.height == 0) return -1;
+    V.mode = pick_mode(s_want_interval);
+    VkSwapchainCreateInfoKHR ci = { VK_STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR };
+    ci.surface = V.surf;
+    ci.minImageCount = caps.minImageCount + 1;
+    if (caps.maxImageCount && ci.minImageCount > caps.maxImageCount) ci.minImageCount = caps.maxImageCount;
+    ci.imageFormat = VK_FORMAT_B8G8R8A8_UNORM;
+    ci.imageColorSpace = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
+    ci.imageExtent = caps.currentExtent;
+    ci.imageArrayLayers = 1;
+    ci.imageUsage = VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    ci.preTransform = caps.currentTransform;
+    ci.compositeAlpha = VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR;
+    ci.presentMode = V.mode;
+    ci.clipped = VK_TRUE;
+    ci.oldSwapchain = V.sc;
+    VkSwapchainKHR sc;
+    if ((s_sc_err = vkCreateSwapchainKHR(V.dev, &ci, NULL, &sc)) != VK_SUCCESS) return 0;
+    destroy_swapchain();
+    V.sc = sc;
+    V.sc_ext = caps.currentExtent;
+    V.sc_n = VKP_MAX_IMAGES;
+    if (vkGetSwapchainImagesKHR(V.dev, V.sc, &V.sc_n, V.sc_img) != VK_SUCCESS) return 0;
+    VkSemaphoreCreateInfo si = { VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO };
+    for (uint32_t i = 0; i < V.sc_n; i++)
+        if (vkCreateSemaphore(V.dev, &si, NULL, &V.present_sem[i]) != VK_SUCCESS) return 0;
+    V.sc_stale = 0;
+    return 1;
+}
