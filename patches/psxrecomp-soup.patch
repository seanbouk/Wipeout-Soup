+/* ---- child window that Vulkan presents to -------------------------------- */
+static HWND s_parent, s_child;
+static LRESULT CALLBACK child_proc(HWND h, UINT msg, WPARAM wp, LPARAM lp) {
+    if (msg == WM_NCHITTEST) return HTTRANSPARENT;    /* input goes to the game window */
+    if (msg == WM_ERASEBKGND) return 1;               /* Vulkan covers every pixel */
+    return DefWindowProcW(h, msg, wp, lp);
+}
+static int create_child(HWND parent) {
+    static ATOM cls = 0;
+    HINSTANCE hi = GetModuleHandleW(NULL);
+    if (!cls) {
+        WNDCLASSEXW wc = { sizeof wc };
+        wc.lpfnWndProc = child_proc;
+        wc.hInstance = hi;
+        wc.lpszClassName = L"PsxRecompVkPresenter";
+        cls = RegisterClassExW(&wc);
+        if (!cls) return 0;
+    }
+    RECT r; GetClientRect(parent, &r);
+    s_child = CreateWindowExW(0, L"PsxRecompVkPresenter", L"", WS_CHILD | WS_VISIBLE | WS_DISABLED,
+                              0, 0, r.right - r.left, r.bottom - r.top, parent, NULL, hi, NULL);
+    if (!s_child) return 0;
+    s_parent = parent;
+    /* GL must not paint over the child (it never presents, but be explicit). */
+    SetWindowLongPtrW(parent, GWL_STYLE, GetWindowLongPtrW(parent, GWL_STYLE) | WS_CLIPCHILDREN);
+    return 1;
+}
+static void sync_child_size(void) {
+    if (!s_child) return;
+    RECT pr, cr; GetClientRect(s_parent, &pr); GetClientRect(s_child, &cr);
+    if (pr.right != cr.right || pr.bottom != cr.bottom)
+        SetWindowPos(s_child, NULL, 0, 0, pr.right, pr.bottom, SWP_NOZORDER | SWP_NOACTIVATE | SWP_NOCOPYBITS);
+}
+static void destroy_child(void) {
+    if (s_child) { DestroyWindow(s_child); s_child = NULL; }
+}
