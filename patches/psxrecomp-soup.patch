+/* Per-object transforms for moving things (psx_mv_object). Two small
+ * open-addressed tables, this render's and the previous render's, keyed by
+ * (object key, matrix ordinal within the object). Swapped at each boundary. */
+struct MvObjXf { uint32_t key; uint16_t ordinal; uint16_t used; int16_t rt[9]; int32_t tr[3]; };
+#define MV_OBJ_CAP 1024u
+static MvObjXf  s_mv_obj_tab[2][MV_OBJ_CAP];
+static int      s_mv_obj_cur = 0;          /* index of this render's table   */
+static uint32_t s_mv_obj = 0;              /* object being drawn, 0 = none   */
+static uint16_t s_mv_obj_nmat = 0;         /* matrices seen for it so far    */
