+static int load_gl(void) {
+#define L(f, n) do { *(void **)&gl.f = (void *)SDL_GL_GetProcAddress(n); if (!gl.f) return 0; } while (0)
+    L(CreateMemoryObjectsEXT, "glCreateMemoryObjectsEXT"); L(DeleteMemoryObjectsEXT, "glDeleteMemoryObjectsEXT"); L(MemoryObjectParameterivEXT, "glMemoryObjectParameterivEXT");
+    L(ImportMemoryWin32HandleEXT, "glImportMemoryWin32HandleEXT"); L(TexStorageMem2DEXT, "glTexStorageMem2DEXT");
+    L(GenSemaphoresEXT, "glGenSemaphoresEXT"); L(DeleteSemaphoresEXT, "glDeleteSemaphoresEXT");
+    L(ImportSemaphoreWin32HandleEXT, "glImportSemaphoreWin32HandleEXT");
+    L(SignalSemaphoreEXT, "glSignalSemaphoreEXT"); L(WaitSemaphoreEXT, "glWaitSemaphoreEXT");
+    L(GenFramebuffers, "glGenFramebuffers"); L(DeleteFramebuffers, "glDeleteFramebuffers");
+    L(BindFramebuffer, "glBindFramebuffer"); L(FramebufferTexture2D, "glFramebufferTexture2D");
+    L(FramebufferRenderbuffer, "glFramebufferRenderbuffer"); L(CheckFramebufferStatus, "glCheckFramebufferStatus");
+    L(GenRenderbuffers, "glGenRenderbuffers"); L(DeleteRenderbuffers, "glDeleteRenderbuffers");
+    L(BindRenderbuffer, "glBindRenderbuffer"); L(RenderbufferStorage, "glRenderbufferStorage");
+    L(GenTextures, "glGenTextures"); L(DeleteTextures, "glDeleteTextures"); L(BindTexture, "glBindTexture");
+    L(Flush, "glFlush"); L(Finish, "glFinish"); L(GetIntegerv, "glGetIntegerv"); L(GetStringi, "glGetStringi"); L(GetError, "glGetError");
+#undef L
+    GLint_ n = 0; int mem = 0, sem = 0;
+    gl.GetIntegerv(VKP_GL_NUM_EXTENSIONS, &n);
+    for (GLint_ i = 0; i < n; i++) {
+        const char *e = (const char *)gl.GetStringi(VKP_GL_EXTENSIONS, (GLuint_)i);
+        if (!e) continue;
+        if (!strcmp(e, "GL_EXT_memory_object_win32")) mem = 1;
+        if (!strcmp(e, "GL_EXT_semaphore_win32")) sem = 1;
+    }
+    return mem && sem;
+}
