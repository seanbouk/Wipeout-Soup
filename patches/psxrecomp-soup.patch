+static uint32_t mv_obj_hash(uint32_t key, uint16_t ord) {
+    uint32_t h = key * 2654435761u ^ (uint32_t)ord * 40503u;
+    return (h ^ (h >> 15)) & (MV_OBJ_CAP - 1);
