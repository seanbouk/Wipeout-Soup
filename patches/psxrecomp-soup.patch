diff --git a/runtime/include/vk_presenter.h b/runtime/include/vk_presenter.h
new file mode 100644
index 00000000..d3e57863
--- /dev/null
+++ b/runtime/include/vk_presenter.h
@@ -0,0 +1,49 @@
+/* Vulkan presenter for the OpenGL renderer (Wipeout Soup Phase 4a).
+ *
+ * The GL renderer keeps rendering exactly as before, but its final present
+ * pass draws into a Vulkan-allocated image that GL imports
+ * (GL_EXT_memory_object_win32). The hand-off uses exported semaphores
+ * (GL_EXT_semaphore_win32), and Vulkan blits that image to a swapchain on the
+ * same window and presents. That puts the frame where Vulkan-only tools
+ * (Streamline / DLSS) can reach it, and gives a real Vulkan swapchain (present
+ * modes) for pacing.
+ *
+ * Windows + PSX_VK_PRESENTER builds only; elsewhere every call is inert and
+ * vkp_init fails, so the GL renderer presents as before. */
+#ifndef PSX_VK_PRESENTER_H
+#define PSX_VK_PRESENTER_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct SDL_Window;
+
+/* Vulkan half: a child window over the game window's client area (Vulkan
+ * and GL can't share one window on NVIDIA), instance, device and swapchain. */
+int  vkp_prepare(struct SDL_Window *win);
+/* GL half (GL context current): import the semaphores and the window-sized
+ * shared image. Runs vkp_prepare itself if it wasn't called. Returns 1 on
+ * success; on failure nothing is left behind and the caller keeps presenting
+ * with GL. */
+int  vkp_init(struct SDL_Window *win);
+/* GL framebuffer to draw the presented frame into (window-sized shared image
+ * with a depth-stencil renderbuffer). Changes when the window is resized. */
+unsigned vkp_fbo(void);
+/* Hand the finished frame to Vulkan and present it. Afterwards the shared image
+ * matches the window's current size (recreated if it changed) and GL waits for
+ * Vulkan to release it before drawing the next frame. */
+void vkp_present(void);
+/* SDL swap-interval semantics: 1 vsync (FIFO), 0 no vsync (MAILBOX: no
+ * waiting and no tearing; immediate if mailbox is missing), -1 adaptive (FIFO
+ * relaxed when available). */
+void vkp_set_vsync(int interval);
+void vkp_shutdown(void);
+/* Debug: one-line status ("off", or device/mode/size). */
+const char *vkp_status(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
